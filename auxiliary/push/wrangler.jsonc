{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "push-worker",
	"main": "index.ts",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"issues": { "enabled": true },
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.05 },
	},
	"kv_namespaces": [{ "binding": "KV_PUSH_SUBSCRIPTION", "id": "190f895e11114532a070bdc243874ef5" }],
	"queues": {
		"producers": [
			{ "binding": "PUSH_QUEUE", "queue": "worker-ide-push" },
			{ "binding": "PUSH_HIGH_QUEUE", "queue": "worker-ide-push-high" },
		],
		"consumers": [
			{
				"max_batch_size": 30,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"queue": "worker-ide-push",
			},
			{
				"max_batch_size": 10,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"queue": "worker-ide-push-high",
			},
		],
	},
	"vars": {
		"VAPID_SUBJECT": "mailto:support@codemaxxing.ai",
	},
	"secrets": {
		"required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY"],
	},
}
