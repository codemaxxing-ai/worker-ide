{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "esbuild-worker",
	"main": "index.ts",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"issues": { "enabled": true },
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.05 },
	},
}
