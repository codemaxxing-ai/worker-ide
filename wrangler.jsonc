/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "d64471fef208e0cf9687449dc8a5878b",
	"name": "worker-ide",
	"main": "worker/index.ts",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat"],
	"cache": {
		"enabled": true,
	},
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"BuildArtifact": { "type": "worker", "cache": { "enabled": true } },
	},
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"issues": { "enabled": true },
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 },
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	"ai": {
		"binding": "AI",
		"remote": true,
	},
	"images": {
		"binding": "IMAGES",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "worker-ide-auth",
			"database_id": "d31c3f46-924a-43c9-ba11-2322e0acd35b",
			"migrations_dir": "./worker/migrations/d1-auth",
		},
	],
	"workflows": [
		{
			"name": "worker-ide-deploy",
			"binding": "DEPLOY_WORKFLOW",
			"class_name": "DeployWorkflow",
		},
	],
	"migrations": [
		{
			"new_sqlite_classes": ["DurableObjectFilesystem", "HMRCoordinator"],
			"tag": "v2",
		},
		{
			"renamed_classes": [
				{
					"from": "HMRCoordinator",
					"to": "ProjectCoordinator",
				},
			],
			"tag": "v3",
		},
		{
			"new_sqlite_classes": ["AgentRunner"],
			"tag": "v4",
		},
		{
			"deleted_classes": ["ProjectCoordinator"],
			"tag": "v5",
		},
		{
			"new_sqlite_classes": ["ProjectCoordinatorV2"],
			"tag": "v6",
		},
		{
			"new_sqlite_classes": ["ProjectMetadata"],
			"tag": "v7",
		},
		{
			"new_sqlite_classes": ["VinextPreviewHost"],
			"tag": "v8",
		},
		{
			"deleted_classes": ["VinextPreviewHost"],
			"tag": "v9",
		},
	],
	"r2_buckets": [
		{
			"binding": "STORAGE_BUCKET",
			"bucket_name": "worker-ide-storage",
		},
	],
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"browser": {
		"binding": "BROWSER",
		// `remote: true` enables Browser Run Quick Actions during local `wrangler dev`.
		"remote": true,
	},
	"ratelimits": [
		{
			"name": "AI_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 300,
				"period": 60,
			},
		},
		{
			"name": "PREVIEW_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 100,
				"period": 60,
			},
		},
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 500,
				"period": 60,
			},
		},
		{
			"name": "STORAGE_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 100,
				"period": 60,
			},
		},
	],
	"services": [
		{
			"binding": "BIOME",
			"service": "biome-worker",
		},
		{
			"binding": "ESBUILD",
			"service": "esbuild-worker",
		},
		{
			"binding": "VITE_HOST",
			"service": "vite-host-worker",
		},
		{
			"binding": "PUSH",
			"service": "push-worker",
		},
		{
			"binding": "EMAIL",
			"service": "email-worker",
		},
	],
	"artifacts": [
		{
			"binding": "ARTIFACTS",
			"namespace": "ide",
			"remote": true,
		},
	],
	"queues": {
		"consumers": [
			{
				// Cloudflare Artifacts event subscription (cf.artifacts.repo.pushed).
				"queue": "artifacts-push-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
			},
		],
	},
	"analytics_engine_datasets": [
		{ "binding": "ANALYTICS_API", "dataset": "worker_ide_api" },
		{ "binding": "ANALYTICS_PROJECTS", "dataset": "worker_ide_projects" },
		{ "binding": "ANALYTICS_AI", "dataset": "worker_ide_ai" },
		{ "binding": "ANALYTICS_PREVIEW", "dataset": "worker_ide_preview" },
		{ "binding": "ANALYTICS_AUTH", "dataset": "worker_ide_auth" },
		{ "binding": "ANALYTICS_WS", "dataset": "worker_ide_ws" },
		{ "binding": "ANALYTICS_STT", "dataset": "worker_ide_stt" },
	],
	"triggers": {
		"crons": ["0 3 * * *"],
	},
	"secrets": {
		"required": [
			"PREVIEW_SECRET",
			"BETTER_AUTH_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"CLOUDFLARE_OAUTH_CLIENT_ID",
			"CLOUDFLARE_OAUTH_CLIENT_SECRET",
		],
	},
}
