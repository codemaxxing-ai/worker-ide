		"@codemirror/lint": "6.9.5",
		"@codemirror/lang-javascript": "6.2.5"
	},
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"postinstall": "bun scripts/vendor-wasm.ts && bun scripts/vendor-vite-host.ts",
		"prepare": "husky",
		"dev": "bun run build:worker-types && concurrently -n vite,types -c blue,yellow \"vite --port 3000\" \"bunx tsc -p tsconfig.worker.json --watch --preserveWatchOutput\"",
		"build": "turbo run build:vite",
		"build:worker-types": "bunx tsc -p tsconfig.worker.json",
		"build:vite": "vite build",
		"typecheck": "turbo run typecheck:app typecheck:node typecheck:worker typecheck:scripts",
		"typecheck:app": "bunx tsc --noEmit -p tsconfig.app.json",
		"typecheck:node": "bunx tsc --noEmit -p tsconfig.node.json",
		"typecheck:worker": "bunx tsc --noEmit -p tsconfig.worker.json",
		"typecheck:scripts": "bunx tsc --noEmit -p tsconfig.scripts.json",
		"lint": "prettier --check . && eslint --cache --format=stylish .",
		"format": "prettier --write . && eslint --cache --format=stylish --fix .",
		"test": "vitest",
		"test:unit": "vitest --project unit",
		"test:worker": "vitest --project worker --maxWorkers=2",
		"test:react": "vitest --project react",
		"test:integration": "vitest run --config test/integration/vitest.config.ts",
		"test:storybook": "vitest run --config .storybook/vitest.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:report": "playwright show-report",
		"preview": "turbo run build:vite && vite preview --host 0.0.0.0 --port 4173",
		"deploy": "bun scripts/deploy.ts",
		"cf-typegen": "bun run scripts/generate-types.ts",
		"db:generate": "drizzle-kit generate --config drizzle-d1.config.ts",
		"db:migrate:local": "wrangler d1 migrations apply worker-ide-auth --local",
		"db:migrate:remote": "wrangler d1 migrations apply worker-ide-auth --remote",
		"knip": "knip",
		"knip:audit": "knip --config knip-audit.json --reporter compact",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	}
}
