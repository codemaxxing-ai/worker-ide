{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"cf-typegen": {
			"outputs": ["worker-configuration.d.ts", "auxiliary/*/worker-configuration.d.ts"],
			"inputs": ["wrangler.jsonc", "auxiliary/*/wrangler.jsonc", "scripts/generate-types.ts", "shared/jsonc.ts"]
		},
		"build:worker-types": {
			"dependsOn": ["cf-typegen"],
			"outputs": ["dist/worker/**"],
			"inputs": ["$TURBO_DEFAULT$"]
		},
		"build:vite": {
			"dependsOn": ["build:worker-types"],
			"outputs": ["dist/**"],
			"inputs": ["$TURBO_DEFAULT$"],
			"env": ["NODE_ENV"]
		},
		"typecheck:app": {
			"dependsOn": ["build:worker-types"],
			"inputs": ["src/**", "shared/**", "tsconfig.app.json", "tsconfig.json"],
			"cache": true
		},
		"typecheck:node": {
			"inputs": ["$TURBO_DEFAULT$"],
			"cache": true
		},
		"typecheck:worker": {
			"dependsOn": ["build:worker-types"],
			"inputs": ["worker/**", "auxiliary/**", "shared/**", "tsconfig.worker.json", "tsconfig.json"],
			"cache": true
		},
		"typecheck:scripts": {
			"inputs": ["scripts/**/*.ts", "shared/**/*.ts", "tsconfig.scripts.json", "tsconfig.json"],
			"cache": true
		},
		"lint": {
			"inputs": ["src/**", "worker/**", "auxiliary/**", "shared/**", "test/**", "eslint.config.js"],
			"cache": true
		},
		"format:check": {
			"inputs": ["**/*.{ts,tsx,js,json,md,css}"],
			"cache": true
		},
		"test": {
			"inputs": ["src/**", "worker/**", "auxiliary/**", "shared/**"],
			"cache": true
		},
		"test:e2e": {
			"inputs": ["src/**", "worker/**", "auxiliary/**", "shared/**", "test/e2e/**", "playwright.config.ts"],
			"env": ["CI"],
			"cache": false
		}
	},
	"globalDependencies": ["mise.toml", ".nvmrc", "raw-minified.d.ts", "tsconfig*.json", "wrangler.jsonc", "auxiliary/*/wrangler.jsonc"]
}
