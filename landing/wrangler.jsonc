{
	"name": "codemaxxing-landing",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
	},
	"observability": {
		"issues": { "enabled": true },
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.05 },
	},
}
